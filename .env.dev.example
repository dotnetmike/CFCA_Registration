# =============================================================================
# DEV environment — copy to .env.dev and fill secrets (never commit .env.dev)
# Branch: dev  |  npm run env:select / npm run dev:dev
# Use a SEPARATE Supabase project from UAT and production.
# =============================================================================

APP_ENV=dev

# =============================================================================
# Server — Supabase (https://supabase.com/dashboard) — DEV project
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Dashboard → Project Settings → API Keys → secret / service_role (server only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Account → Access Tokens (sbp_…). Used by npm run db:deploy
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME

# =============================================================================
# UI / app — also set these on Vercel Preview (branch: dev)
# =============================================================================

# Auth (generate unique GUIDs per environment — do not reuse production secrets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=6h

SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# Set true on Vercel if you apply migrations separately
# SKIP_DB_DEPLOY=true

REGISTRATION_CODE_PREFIX=CFCA27-DEV

# Resend (default) or Microsoft 365 Graph — see docs/operations/email.md
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# EMAIL_FROM is used by Resend only (ignored when EMAIL_PROVIDER=office365)
EMAIL_FROM=CFCA Registration DEV <noreply@example.com>
# OFFICE365_TENANT_ID=
# OFFICE365_CLIENT_ID=
# OFFICE365_CLIENT_SECRET=
# OFFICE365_USERNAME=
# OFFICE365_FROM_NAME=CFCA National Conference 2027

CRON_SECRET=

# CFCA bank transfer details are managed in Dashboard → Registration Settings (not env)

# Stripe (optional — required for V2 Online Payment via Stripe Checkout). Leave unset for bank-only.
# Dashboard workflow default is V1; set V2 in Registration Settings after sign-off.
# Webhook URL (Stripe Dashboard or `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook`)
# REGISTRATION_WORKFLOW=v1
STRIPE_SECRET_KEY=

GOOGLE_MAPS_API_KEY=
