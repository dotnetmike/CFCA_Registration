# =============================================================================
# PRODUCTION environment — copy to .env.production and fill secrets
# Branch: master (or main)  |  npm run env:select / npm run dev:production
# Use the PRODUCTION Supabase project only. Never point DEV/UAT apps here.
# =============================================================================

APP_ENV=production

# =============================================================================
# Server — Supabase (https://supabase.com/dashboard) — PRODUCTION project
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Dashboard → Project Settings → API Keys → secret / service_role (server only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Account → Access Tokens (sbp_…). Used by npm run db:deploy
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME

# =============================================================================
# UI / app — also set these on Vercel Production
# =============================================================================

# Auth (generate unique GUIDs per environment)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=6h

SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# Set true on Vercel if you apply migrations separately
# SKIP_DB_DEPLOY=true

REGISTRATION_CODE_PREFIX=CFCA26

# Resend (default) or Microsoft 365 Graph — see docs/operations/email.md
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# EMAIL_FROM is used by Resend only (ignored when EMAIL_PROVIDER=office365)
EMAIL_FROM=CFCA Registration <noreply@example.com>
# OFFICE365_TENANT_ID=
# OFFICE365_CLIENT_ID=
# OFFICE365_CLIENT_SECRET=
# OFFICE365_USERNAME=
# OFFICE365_FROM_NAME=CFCA National Conference 2026

CRON_SECRET=
PAYMENT_REMINDER_DATE_1=2026-02-14
PAYMENT_REMINDER_DATE_2=2026-03-31
PAYMENT_REMINDER_DATE_3=2026-07-01

# CFCA bank transfer details are managed in Dashboard → Registration Settings (not env)

# Stripe (optional — required for V2 Online Payment via Stripe Checkout)
# Webhook URL (Stripe Dashboard): https://YOUR_DOMAIN/api/payments/stripe/webhook
# REGISTRATION_WORKFLOW=v1
STRIPE_SECRET_KEY=

GOOGLE_MAPS_API_KEY=
