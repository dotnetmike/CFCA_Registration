# =============================================================================
# UAT environment — copy to .env.uat and fill secrets (never commit .env.uat)
# Branch: uat  |  npm run env:select / npm run dev:uat
# Use a SEPARATE Supabase project from DEV and production.
# =============================================================================

APP_ENV=uat

# =============================================================================
# Server — Supabase (https://supabase.com/dashboard) — UAT project
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_UAT_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Dashboard → Project Settings → API Keys → secret / service_role (server only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Account → Access Tokens (sbp_…). Used by npm run db:deploy
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME

# =============================================================================
# UI / app — also set these on Vercel Preview (branch: uat)
# =============================================================================

# Auth (generate unique GUIDs per environment — do not reuse production secrets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=6h

SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# Set true on Vercel if you apply migrations separately
# SKIP_DB_DEPLOY=true

REGISTRATION_CODE_PREFIX=CFCA26-UAT

# Resend
RESEND_API_KEY=
EMAIL_FROM="CFCA Registration UAT <noreply@example.com>"

CRON_SECRET=
PAYMENT_REMINDER_DATE_1=2026-02-14
PAYMENT_REMINDER_DATE_2=2026-03-31
PAYMENT_REMINDER_DATE_3=2026-07-01

NEXT_PUBLIC_BANK_ACCOUNT_NAME=CFCA Conference UAT
NEXT_PUBLIC_BANK_BSB=000-000
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=00000000

GOOGLE_MAPS_API_KEY=
